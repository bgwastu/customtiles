<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_tile_hbm"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Camera Quick Settings Tile -->
        <service
            android:name=".CameraTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_camera"
            android:label="@string/tile_camera_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Max Brightness (HBM) Quick Settings Tile -->
        <service
            android:name=".HbmTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_hbm"
            android:label="@string/tile_hbm_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Light Colors (Washed Out Display) Quick Settings Tile -->
        <service
            android:name=".LightColorTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_light_color"
            android:label="@string/tile_light_color_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
